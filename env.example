# Copy to .env.local in this folder (recommended for Next.js), or put the same
# variables in global.env and run via run-web-knowledge-pipeline.bat (loads global.env).

# --- Local Docker (recommended — free search + scrape) ---
# Start: scripts\start-docker-services.bat  or  docker compose -f docker/docker-compose.yml up -d
SEARXNG_URL=http://localhost:8888
CRAWL4AI_BASE_URL=http://localhost:11235
SCRAPE_ENGINE=crawl4ai

# --- Optional cloud search / scrape ---
EXA_API_KEY=exa-your-key-here
TAVILY_API_KEY=tvly-your-key-here
FIRECRAWL_API_KEY=fc-your-key-here

# Optional — Firebase (not used by the MVP UI yet)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
