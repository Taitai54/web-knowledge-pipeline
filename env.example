# Copy to .env.local in this folder (recommended for Next.js), or put the same
# variables in global.env and run via run-web-knowledge-pipeline.bat (loads global.env).

# --- Local Docker (recommended — free search + scrape) ---
# Start: scripts\start-docker-services.bat  or  docker compose -f docker/docker-compose.yml up -d
SEARXNG_URL=http://localhost:8888
CRAWL4AI_BASE_URL=http://localhost:11235
SCRAPE_ENGINE=crawl4ai

# --- Optional cloud search / scrape ---
EXA_API_KEY=exa-your-key-here
TAVILY_API_KEY=tvly-your-key-here
BRAVE_API_KEY=BSA-your-key-here
FIRECRAWL_API_KEY=fc-your-key-here
# Optional. Jina Reader works without a key; a key raises the rate limit.
# JINA_API_KEY=

# --- RAG chat (required for answers, not for search/scrape) ---
# Sync and the search server read PINECONE_API_KEY from the environment.
# Next.js reads the LLM key from .env.local or from the process environment.
# PINECONE_API_KEY=
# PINECONE_INDEX=peace
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Local chat models. RAG Chat can also point at these from Keys and servers.
# OLLAMA_URL=http://127.0.0.1:11434
# LMSTUDIO_URL=http://127.0.0.1:1234
# run-web-knowledge-pipeline.bat starts the search server on port 8765 with the app.
# SEARCH_SERVER_URL=http://localhost:8765

# Optional — Firebase (not used by the MVP UI yet)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
